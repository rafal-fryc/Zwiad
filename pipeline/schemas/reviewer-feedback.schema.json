{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reviewer Feedback Per Round",
  "description": "Schema for reviewer agent feedback output per review round",
  "type": "object",
  "required": ["finding_id", "report_path", "round", "claims_checked", "issues", "resolution_status"],
  "properties": {
    "finding_id": { "type": "string" },
    "report_path": { "type": "string" },
    "round": { "type": "integer", "minimum": 1, "maximum": 3 },
    "claims_checked": { "type": "integer", "minimum": 0 },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "section", "source_url", "issue", "severity", "suggested_fix", "status"],
        "properties": {
          "claim": { "type": "string" },
          "section": { "type": "string" },
          "source_url": { "type": "string" },
          "issue": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "major", "minor"] },
          "suggested_fix": { "type": "string" },
          "status": { "type": "string", "enum": ["open", "fixed", "disputed", "upheld", "withdrawn"] }
        },
        "additionalProperties": false
      }
    },
    "resolution_status": { "type": "string", "enum": ["issues-found", "resolved", "escalate", "error"] }
  },
  "additionalProperties": false
}
