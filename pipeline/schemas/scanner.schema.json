{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scanner Stage Data",
  "description": "Schema for scanner agent output data field",
  "type": "object",
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "source", "source_url", "summary", "relevance", "jurisdiction", "development_type", "category"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "source": { "type": "string" },
          "source_url": { "type": "string" },
          "summary": { "type": "string" },
          "date": { "type": "string" },
          "relevance": { "type": "string", "enum": ["high", "medium", "low"] },
          "jurisdiction": { "type": "string" },
          "development_type": { "type": "string", "enum": ["legislation", "regulation", "enforcement", "guidance", "court-decision", "other"] },
          "category": { "type": "string", "enum": ["privacy", "cybersecurity", "ai-law"] },
          "topic_key": { "type": "string" },
          "topic_type": {
            "type": "string",
            "enum": ["state_bill", "federal_bill", "enforcement", "rulemaking", "guidance", "other"]
          },
          "topic_key_confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        },
        "additionalProperties": false
      }
    },
    "source_failures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "error"],
        "properties": {
          "source_id": { "type": "string" },
          "source_name": { "type": "string" },
          "error": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
